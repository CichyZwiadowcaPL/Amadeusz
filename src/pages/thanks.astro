---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout title="Message sent" description="Thank you for contacting Aerospace Development Group.">
  <PageIntro eyebrow="Message sent" title="Thank you for your message.">
    We've received your message and will get back to you as soon as possible.
  </PageIntro>
  <section>
    <div class="wrap actions">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn btn-ghost" href="/research">See our R&amp;D progress</a>
    </div>
  </section>
</Layout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
