---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StageTrack from '../../components/StageTrack.astro';
import PartnerLogo from '../../components/PartnerLogo.astro';
import { programmes, updates } from '../../data/research';
import { partners } from '../../data/partners';

const nuada = programmes.find((p) => p.name === 'Nuada I')!;
const log = updates.filter((u) => u.programme === 'Nuada I').reverse();

const facts = [
  { value: '2 km', label: 'Target altitude' },
  { value: '2021 – 2026', label: 'Programme duration' },
  { value: '20+', label: 'People involved' },
  { value: String(partners.length), label: 'Partners' },
];

const systems = [
  {
    title: 'Electronics',
    body: 'The “heart” of the rocket: our own flight computer (PCB) that reads an altimeter, accelerometer, speed sensor and GPS, and triggers the right actions in each phase of the flight.',
  },
  {
    title: 'Construction & aerodynamics',
    body: 'A composite structure that carries all forces from the motor and houses the internal systems. We tested it destructively: tensile tests at the ROC Amsterdam composite lab showed the load-bearing connections can take many times the motor’s thrust.',
  },
  {
    title: 'Recovery',
    body: 'A dual-deploy system: a drogue parachute opens high up to slow the rocket down, and the main parachute opens close to the ground for a gentle landing at around 6 m/s.',
  },
  {
    title: 'Solid booster & fuel',
    body: 'Our own solid rocket motor, SB-N-01 — an L-class booster developed in-house for Nuada I. See the results below.',
  },
  {
    title: 'Nose cone',
    body: 'A 3D-printed nose cone, produced together with Dextro-Tech.',
  },
  {
    title: 'Project & safety',
    body: 'Run according to the NERO safety statute, EU Directive 2014/28/EU on civil explosives and the European Rocketry Challenge (EuRoC) design and test rules.',
  },
];

// Nuada I flight & recovery simulations (OpenRocket), June 2024.
const flight = [
  { value: '≈ 2,000 m', label: 'Simulated apogee (2,036 m)' },
  { value: 'Mach 0.77', label: 'Max. velocity (262 m/s)' },
  { value: '157 m/s²', label: 'Max. acceleration' },
  { value: '1.61 cal', label: 'Stability margin' },
];

const recovery = [
  { step: '1,800 m', text: 'Drogue parachute opens — descent slowed to about 40 m/s' },
  { step: '450 m', text: 'Main parachute opens — descent slowed to about 6 m/s' },
  { step: 'Ground', text: 'Safe landing of the complete rocket' },
];

// SB-N-01 solid booster — final results of the OpenMotor simulation (Nov 2024).
// Only end figures are published, no design or manufacturing details.
const booster = [
  { value: 'L-class', label: 'Motor class' },
  { value: '≈ 3,600 Ns', label: 'Total impulse' },
  { value: '≈ 3 kN', label: 'Peak thrust' },
  { value: '≈ 2 s', label: 'Burn time' },
  { value: '≈ 144 s', label: 'Specific impulse (Isp)' },
  { value: '< 10 MPa', label: 'Chamber pressure — within design limit' },
];

// Simulated thrust curve (time in s, thrust in N), traced from the simulation graph.
const curve = [
  [0, 0], [0.03, 950], [0.25, 1220], [0.5, 1500], [0.75, 1760], [1.0, 2000],
  [1.25, 2250], [1.5, 2480], [1.75, 2680], [1.87, 2780], [1.92, 0],
];
const W = 600, H = 260, PAD = { l: 52, r: 16, t: 16, b: 36 };
const xMax = 2.0, yMax = 3000;
const sx = (t: number) => PAD.l + (t / xMax) * (W - PAD.l - PAD.r);
const sy = (n: number) => H - PAD.b - (n / yMax) * (H - PAD.t - PAD.b);
const linePath = curve.map(([t, n], i) => `${i ? 'L' : 'M'}${sx(t).toFixed(1)},${sy(n).toFixed(1)}`).join(' ');
const areaPath = `${linePath} L${sx(1.92).toFixed(1)},${sy(0).toFixed(1)} Z`;
const yTicks = [0, 1000, 2000, 3000];
const xTicks = [0, 0.5, 1, 1.5, 2];

const photos = [
  { src: '/nuada/cad-aft-section.jpg', alt: 'CAD model of the Nuada I aft section', caption: 'CAD model of the Nuada I aft section with fins and motor mount.' },
  { src: '/nuada/motor-casing.jpg', alt: 'Nuada I motor casing parts', caption: 'Hardware in the workshop.' },
  { src: '/nuada/machining.jpg', alt: 'Machining a Nuada I part on a milling machine', caption: 'Machining parts in the partner workshop.' },
];
---

<Layout
  title="Nuada I"
  description="Nuada I: Aerospace Development Group's first research rocket — five years of work, 20+ people and six partners."
>
  <PageIntro eyebrow="R&D programme · Rocketry · Complete" title="Nuada I">
    Our first rocket programme and the foundation of ADG Aerospace. Named after the Celtic god
    of air, Nuada I was a solid-fuel research rocket designed to reach 2 km, developed from 2021 to 2026 by more than 20
    people together with our partners. Its technology now lives on in Nuada II and our other
    projects.
  </PageIntro>

  <section class="facts-section">
    <div class="wrap">
      <div class="facts">
        {facts.map((f) => (
          <div class="card fact">
            <div class="fact-value">{f.value}</div>
            <div class="fact-label">{f.label}</div>
          </div>
        ))}
      </div>
      <div class="card stage-card">
        <p class="stage-title">Programme status</p>
        <StageTrack stage={nuada.stage} />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap story">
      <div>
        <p class="eyebrow">The mission</p>
        <h2>Building knowledge from the ground up.</h2>
      </div>
      <div class="story-text">
        <p>
          The Nuada programme started in early 2021 at Deltion College in Zwolle, with a bold first
          idea: Nuada-0, a rocket with a liquid engine aiming for 10 km. The concept was nominated
          for an award — and taught us to set a realistic first goal. So we switched to Nuada I: a
          solid-fuel research rocket that a young team could really design, build and test.
        </p>
        <p>
          Nuada I was split into four systems — electronics, construction &amp; aerodynamics,
          recovery, and the solid booster &amp; fuel. Every system was designed, simulated and
          tested before being approved. Along the way we built not just a rocket, but also the
          organisation behind it: ARIE Aerospace, which became ADG Aerospace.
        </p>
        <p>
          Over five years more than 20 people and our partners contributed to the project. Nuada I
          is now finished, and the technology and lessons learned are carried over to Nuada II and
          our other projects.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we developed</p>
          <h2>Four systems, one rocket.</h2>
        </div>
      </div>
      <div class="grid work-grid">
        {systems.map((w) => (
          <div class="card">
            <h3>{w.title}</h3>
            <p class="muted">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="flight-panel">
        <div class="flight-head">
          <p class="eyebrow">Flight &amp; recovery simulation</p>
          <h2>How Nuada I was designed to fly.</h2>
          <p class="flight-note">Results of our Nuada I flight and parachute simulations (June 2024).</p>
        </div>
        <div class="flight-stats">
          {flight.map((f) => (
            <div class="flight-stat">
              <div class="flight-value">{f.value}</div>
              <div class="flight-label">{f.label}</div>
            </div>
          ))}
        </div>
        <ol class="recovery">
          {recovery.map((r) => (
            <li>
              <span class="recovery-step">{r.step}</span>
              <span>{r.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="flight-panel">
        <div class="flight-head">
          <p class="eyebrow">Solid booster SB-N-01</p>
          <h2>Results of our own rocket motor.</h2>
          <p class="flight-note">Final figures from the SB-N-01 simulation (November 2024).</p>
        </div>
        <div class="booster-grid">
          <div class="flight-stats">
            {booster.map((f) => (
              <div class="flight-stat">
                <div class="flight-value">{f.value}</div>
                <div class="flight-label">{f.label}</div>
              </div>
            ))}
          </div>
          <figure class="chart">
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Simulated thrust curve: thrust rises from about 1 kN to about 2.8 kN over roughly 1.9 seconds, then drops to zero at burnout.">
              <defs>
                <linearGradient id="thrust-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#5a8cc9" stop-opacity="0.45" />
                  <stop offset="1" stop-color="#5a8cc9" stop-opacity="0" />
                </linearGradient>
              </defs>
              {yTicks.map((n) => (
                <g>
                  <line x1={PAD.l} x2={W - PAD.r} y1={sy(n)} y2={sy(n)} class="grid-line" />
                  <text x={PAD.l - 8} y={sy(n) + 4} text-anchor="end" class="tick">{n === 0 ? '0' : `${n / 1000} kN`}</text>
                </g>
              ))}
              {xTicks.map((t) => (
                <text x={sx(t)} y={H - PAD.b + 20} text-anchor="middle" class="tick">{t} s</text>
              ))}
              <path d={areaPath} fill="url(#thrust-fill)" />
              <path d={linePath} class="thrust-line" />
            </svg>
            <figcaption>Simulated thrust over time</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Gallery</p>
          <h2>From CAD to hardware.</h2>
        </div>
      </div>
      <div class="gallery">
        {photos.map((ph) => (
          <figure class="photo">
            <img src={ph.src} alt={ph.alt} loading="lazy" />
            <figcaption>{ph.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="partners">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Partners</p>
          <h2>Made possible by our partners.</h2>
        </div>
      </div>
      <p class="partners-lede">
        The partnerships behind Nuada I were established during the project. Each partner
        supported our research in its own way.
      </p>
      <div class="grid partner-grid">
        {partners.map((partner) => (
          <div class="card partner">
            <div class="partner-logo-box"><PartnerLogo partner={partner} /></div>
            <p class="partner-name">{partner.name}</p>
            <p class="muted small">{partner.contribution}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {log.length > 0 && (
    <section>
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Timeline</p>
            <h2>Milestones.</h2>
          </div>
        </div>
        <ol class="timeline">
          {log.map((u) => (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <p class="meta">{u.date}</p>
              <h3>{u.title}</h3>
              <p class="muted">{u.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>What came next.</h2>
          <p>Nuada I laid the foundation for Nuada II and for our engineering services.</p>
        </div>
        <a class="btn" href="/research">See all R&amp;D programmes</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .facts-section {
    padding-bottom: 0;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .fact {
    text-align: center;
    padding: 24px 16px;
  }

  .fact-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .fact-label {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .stage-card {
    margin-top: 20px;
    padding: 20px 24px;
  }

  .stage-title {
    margin: 0 0 12px;
    font-weight: 600;
  }

  .flight-panel {
    border-radius: 20px;
    padding: 40px;
    color: #ffffff;
    background:
      radial-gradient(ellipse at 85% 0%, rgba(90, 140, 201, 0.3), transparent 60%),
      linear-gradient(160deg, #0a1733, #060c1a);
  }

  .flight-head h2 {
    margin: 8px 0 6px;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .flight-head .eyebrow {
    color: #8fb3e0;
  }

  .flight-note {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
  }

  .flight-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0;
  }

  .flight-stat {
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
  }

  .flight-value {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .flight-label {
    margin-top: 4px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .booster-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 24px;
    align-items: center;
    margin-top: 28px;
  }

  .booster-grid .flight-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .chart {
    margin: 0;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }

  .chart svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .grid-line {
    stroke: rgba(255, 255, 255, 0.1);
  }

  .tick {
    fill: rgba(255, 255, 255, 0.6);
    font-size: 12px;
  }

  .thrust-line {
    fill: none;
    stroke: #8fb3e0;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .chart figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    text-align: center;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .photo {
    margin: 0;
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .photo figcaption {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .recovery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .recovery li {
    display: flex;
    align-items: baseline;
    gap: 16px;
    color: rgba(255, 255, 255, 0.85);
  }

  .recovery-step {
    flex: 0 0 90px;
    font-weight: 700;
    color: #8fb3e0;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px 64px;
  }

  .story h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 8px 0 0;
  }

  .story-text p {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  h3 {
    margin: 0 0 8px;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
  }

  .work-grid,
  .partner-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .partners-lede {
    max-width: 720px;
    margin: -12px 0 28px;
    color: var(--text-muted);
  }

  .partner-logo-box {
    display: flex;
    align-items: center;
    height: 56px;
    margin-bottom: 14px;
  }

  .partner-name {
    font-weight: 600;
    margin-bottom: 4px !important;
  }

  .small {
    font-size: 0.92rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    border-left: 2px solid var(--border);
    max-width: 760px;
  }

  .timeline li {
    position: relative;
    padding-bottom: 28px;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .dot {
    position: absolute;
    left: -36px;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
  }

  .meta {
    margin: 0 0 4px !important;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .timeline h3 {
    margin: 0 0 6px;
  }

  @media (max-width: 900px) {
    .facts,
    .flight-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flight-panel {
      padding: 28px 22px;
    }

    .flight-value {
      font-size: 1.2rem;
      white-space: nowrap;
    }

    .recovery-step {
      flex-basis: 70px;
    }

    .story,
    .work-grid,
    .partner-grid,
    .booster-grid,
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
