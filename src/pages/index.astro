---
import Layout from '../layouts/Layout.astro';
import StageTrack from '../components/StageTrack.astro';
import Backdrop from '../components/Backdrop.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { partners } from '../data/partners';
import { programmes, updates, stages } from '../data/research';
import { services } from '../data/services';
import { site } from '../data/site';

const active = programmes.filter((p) => p.stage < stages.length - 1).length;
const completed = programmes.length - active;

const stats = [
  { value: String(active), label: 'Active R&D programmes' },
  { value: String(completed), label: 'Completed programmes' },
  { value: String(services.length), label: 'Engineering services' },
  { value: String(site.founded), label: 'Founded' },
];

const latest = updates.slice(0, 3);
---

<Layout title="Engineering bureau">
  <section class="hero">
    <Backdrop variant="dark" />
    <div class="wrap hero-inner">
      <p class="eyebrow">Engineering bureau · Research &amp; development</p>
      <h1>We research, design and build engineering solutions.</h1>
      <p class="hero-lede">
        Since 2021, Aerospace Development Group has been developing its own aerospace
        technology. Today we are a Dutch engineering bureau with an in-house R&amp;D team, and we
        put the same skills to work for clients who need engineering consultancy or custom
        products.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/services">What we can do for you</a>
        <a class="btn btn-ghost" href="/research">Follow our R&amp;D progress</a>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-grid">
      {stats.map((stat) => (
        <div class="card stat-card">
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Research &amp; development</p>
          <h2>Where our programmes stand.</h2>
        </div>
        <a class="link" href="/research">Full progress report →</a>
      </div>
      <div class="grid two">
        {programmes.map((p) => (
          <article class="card programme">
            <div class="programme-head">
              <h3>{p.name}</h3>
              <span class="pill">{p.area}</span>
            </div>
            <StageTrack stage={p.stage} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Latest updates</p>
          <h2>Recent progress.</h2>
        </div>
        <a class="link" href="/research#log">All updates →</a>
      </div>
      <div class="grid three">
        {latest.map((u) => (
          <article class="card update">
            <p class="update-meta">{u.date} · {u.programme}</p>
            <h3>{u.title}</h3>
            <p class="muted">{u.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">For clients</p>
          <h2>Engineering consultancy &amp; products.</h2>
        </div>
        <a class="link" href="/services">All services →</a>
      </div>
      <div class="grid three">
        {services.slice(0, 6).map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Partners</p>
          <h2>Built together with our partners.</h2>
        </div>
        <a class="link" href="/about#partners">How they help us →</a>
      </div>
      <ul class="logo-strip">
        {partners.map((partner) => (
          <li title={partner.name}>
            <PartnerLogo partner={partner} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Have an engineering challenge?</h2>
          <p>Tell us about your project. We'll get back to you with how we can help.</p>
        </div>
        <a class="btn" href="/contact">Start a conversation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 0;
    color: #ffffff;
    isolation: isolate;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: 120px 170px;
  }

  .hero .eyebrow {
    color: #8fb3e0;
  }

  .hero-inner > * {
    max-width: 760px;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 16px 0 20px;
  }

  .hero-lede {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    margin: 0 0 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero .btn-primary {
    background: #ffffff;
    color: var(--accent-strong);
  }

  .hero .btn-ghost {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .hero .btn-ghost:hover {
    border-color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 72px 120px;
    }
  }

  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .logo-strip li {
    display: grid;
    place-items: center;
    min-height: 96px;
    padding: 18px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  @media (max-width: 960px) {
    .logo-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .logo-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .logo-strip li {
      min-height: 80px;
      padding: 14px;
    }
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .stat-card {
    text-align: center;
    padding: 24px 16px;
  }

  .stat-value {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    color: var(--text-muted);
    margin-top: 4px;
    font-size: 0.9rem;
  }

  .two {
    grid-template-columns: repeat(2, 1fr);
  }

  .three {
    grid-template-columns: repeat(3, 1fr);
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
  }

  .programme-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .programme-head h3 {
    margin: 0;
  }

  .update-meta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px !important;
  }

  @media (max-width: 860px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .two,
    .three {
      grid-template-columns: 1fr;
    }
  }
</style>
