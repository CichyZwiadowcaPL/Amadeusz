---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { services, products, process } from '../data/services';

const audiences = [
  { title: 'Companies', body: 'Extra engineering capacity or specialist skills for a product or project.' },
  { title: 'Start-ups', body: 'Turning an idea into a working, testable prototype.' },
  { title: 'Research institutions', body: 'A practical engineering partner for research and grant-funded projects.' },
];
---

<Layout
  title="Services & products"
  description="Engineering consultancy services and products offered by Aerospace Development Group."
>
  <PageIntro eyebrow="Services & products" title="What ADG can do for you.">
    The skills and tools we use in our own R&amp;D are available to clients. Whether you need
    a design reviewed, a prototype built, a test campaign run or a long-term engineering
    partner, we can help.
  </PageIntro>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Engineering consultancy</p>
          <h2>Services.</h2>
        </div>
      </div>
      <div class="grid three">
        {services.map((s) => (
          <article class="card service">
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
            <ul>
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Products</p>
          <h2>Technology from our R&amp;D.</h2>
        </div>
        <a class="link" href="/research">See how they were developed →</a>
      </div>
      <div class="grid three">
        {products.map((p) => (
          <article class="card product">
            <span class="pill">{p.availability}</span>
            <h3>{p.name}</h3>
            <p class="muted">{p.body}</p>
            <a class="enquire" href={`/contact?topic=${encodeURIComponent('Products')}`}>Enquire →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Who we work with</p>
          <h2>Built for teams of any size.</h2>
        </div>
      </div>
      <div class="grid three">
        {audiences.map((a) => (
          <div class="card">
            <h3>{a.title}</h3>
            <p class="muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">How it works</p>
          <h2>From first message to delivery.</h2>
        </div>
      </div>
      <ol class="steps">
        {process.map((step, i) => (
          <li class="card">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p class="muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Let's discuss your project.</h2>
          <p>Send us a short description and we'll reply with how we can help and the next steps.</p>
        </div>
        <a class="btn" href="/contact">Request a consultation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .three {
    grid-template-columns: repeat(3, 1fr);
  }

  h3 {
    margin: 0 0 8px;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
  }

  .service ul {
    margin: 16px 0 0;
    padding: 16px 0 0 18px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .service li {
    margin-bottom: 4px;
  }

  .product {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .product h3 {
    margin: 4px 0 0;
  }

  .enquire {
    margin-top: auto;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .enquire:hover {
    text-decoration: underline;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 8px;
  }

  @media (max-width: 900px) {
    .three {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
