---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';

const topics = ['Engineering consultancy', 'Product development', 'R&D partnership', 'Careers', 'Other'];

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: 'linkedin.com/company/adg-aerospace ↗', href: site.linkedin },
  { label: 'Location', value: site.location, href: undefined },
];
---

<Layout title="Contact" description="Get in touch with Aerospace Development Group.">
  <PageIntro eyebrow="Contact" title="Let's talk.">
    Need engineering support, help developing a product or want to collaborate on research?
    Send us a message. The more you tell us about your project, the better we can help.
  </PageIntro>

  <section class="contact">
    <div class="wrap contact-grid">
      <form
        class="card form"
        name="contact"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="company-website"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Leave this empty <input name="company-website" /></label>
        </p>
        <div class="row">
          <label>
            Name
            <input type="text" name="name" required placeholder="Your name" />
          </label>
          <label>
            Email
            <input type="email" name="email" required placeholder="you@example.com" />
          </label>
        </div>
        <label>
          <span>Organisation <span class="optional">(optional)</span></span>
          <input type="text" name="organisation" placeholder="Company or institution" />
        </label>
        <label>
          Topic
          <select name="topic" id="topic">
            {topics.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label>
          Message
          <textarea
            name="message"
            rows="6"
            required
            placeholder="Describe your project, what you need and your timeline."
          ></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send message</button>
        <p class="form-error" id="form-error" hidden>
          Something went wrong while sending your message. Please try again, or email us at
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </form>

      <div class="channels">
        {channels.map((channel) => (
          <div class="card channel-card">
            <p class="channel-label">{channel.label}</p>
            {channel.href ? (
              <a
                class="channel-value"
                href={channel.href}
                {...(channel.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {channel.value}
              </a>
            ) : (
              <p class="channel-value">{channel.value}</p>
            )}
          </div>
        ))}
        <div class="card channel-card">
          <p class="channel-label">Company details</p>
          <p class="muted small">
            {site.tradeName}<br />
            KvK: {site.kvk}<br />
            BTW-id: {site.vatId}
          </p>
        </div>
        <div class="card channel-card">
          <p class="channel-label">What happens next</p>
          <p class="muted small">
            We read every message and reply with a short call or written proposal to scope
            your project.
          </p>
        </div>
      </div>
    </div>
  </section>

  <dialog class="thanks" id="thanks-dialog" aria-labelledby="thanks-title">
    <div class="thanks-icon" aria-hidden="true">✓</div>
    <h2 id="thanks-title">Thank you for your message.</h2>
    <p>We will contact you as soon as possible.</p>
    <form method="dialog">
      <button class="btn btn-primary" type="submit">Close</button>
    </form>
  </dialog>
</Layout>

<script>
  // Submit the form in the background (Netlify Forms) and show a pop-up instead of a new page.
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  const dialog = document.getElementById('thanks-dialog') as HTMLDialogElement | null;
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    if (error) error.hidden = true;

    try {
      const data = new URLSearchParams();
      new FormData(form).forEach((value, key) => data.append(key, String(value)));
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString(),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.reset();
      if (dialog?.showModal) dialog.showModal();
      else alert('Thank you for your message. We will contact you as soon as possible.');
    } catch {
      if (error) error.hidden = false;
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    }
  });

  // Close the pop-up when clicking outside it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // Pre-select the topic when linked as /contact?topic=Careers
  const topic = new URLSearchParams(window.location.search).get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) {
    select.value = topic;
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .optional {
    font-size: 0.8rem;
  }

  .hidden {
    display: none;
  }

  .form input,
  .form select,
  .form textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    resize: vertical;
  }

  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-error {
    margin: 0;
    font-size: 0.9rem;
    color: #b42318;
  }

  .form-error a {
    color: inherit;
    font-weight: 600;
  }

  .thanks {
    width: min(420px, calc(100% - 32px));
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 36px 32px 28px;
    text-align: center;
    color: var(--text);
    background: var(--bg);
    box-shadow: 0 24px 60px rgba(6, 12, 26, 0.25);
  }

  .thanks::backdrop {
    background: rgba(6, 12, 26, 0.45);
    backdrop-filter: blur(2px);
  }

  .thanks-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  }

  .thanks h2 {
    margin: 0 0 8px;
    font-size: 1.3rem;
  }

  .thanks p {
    margin: 0 0 24px;
    color: var(--text-muted);
  }

  .thanks button {
    border: none;
    cursor: pointer;
  }

  .form button {
    align-self: flex-start;
    border: none;
    cursor: pointer;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel-card {
    padding: 20px;
  }

  .channel-label {
    margin: 0 0 6px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .channel-value {
    margin: 0;
    font-weight: 600;
    text-decoration: none;
  }

  .small {
    margin: 0;
    font-size: 0.92rem;
  }

  a.channel-value:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .contact-grid,
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
