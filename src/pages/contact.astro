---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';

const topics = ['Engineering consultancy', 'Products', 'R&D partnership', 'Careers', 'Other'];

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'Location', value: site.location, href: undefined },
];
---

<Layout title="Contact" description="Get in touch with Aerospace Development Group.">
  <PageIntro eyebrow="Contact" title="Let's talk.">
    Need engineering support, interested in our products or want to collaborate on research?
    Send us a message. The more you tell us about your project, the better we can help.
  </PageIntro>

  <section class="contact">
    <div class="wrap contact-grid">
      <form
        class="card form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="company-website"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Leave this empty <input name="company-website" /></label>
        </p>
        <div class="row">
          <label>
            Name
            <input type="text" name="name" required placeholder="Your name" />
          </label>
          <label>
            Email
            <input type="email" name="email" required placeholder="you@example.com" />
          </label>
        </div>
        <label>
          <span>Organisation <span class="optional">(optional)</span></span>
          <input type="text" name="organisation" placeholder="Company or institution" />
        </label>
        <label>
          Topic
          <select name="topic" id="topic">
            {topics.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label>
          Message
          <textarea
            name="message"
            rows="6"
            required
            placeholder="Describe your project, what you need and your timeline."
          ></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>

      <div class="channels">
        {channels.map((channel) => (
          <div class="card channel-card">
            <p class="channel-label">{channel.label}</p>
            {channel.href ? (
              <a class="channel-value" href={channel.href}>{channel.value}</a>
            ) : (
              <p class="channel-value">{channel.value}</p>
            )}
          </div>
        ))}
        <div class="card channel-card">
          <p class="channel-label">What happens next</p>
          <p class="muted small">
            We read every message and reply with a short call or written proposal to scope
            your project.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pre-select the topic when linked as /contact?topic=Products
  const topic = new URLSearchParams(window.location.search).get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) {
    select.value = topic;
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .optional {
    font-size: 0.8rem;
  }

  .hidden {
    display: none;
  }

  .form input,
  .form select,
  .form textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    resize: vertical;
  }

  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form button {
    align-self: flex-start;
    border: none;
    cursor: pointer;
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel-card {
    padding: 20px;
  }

  .channel-label {
    margin: 0 0 6px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .channel-value {
    margin: 0;
    font-weight: 600;
    text-decoration: none;
  }

  .small {
    margin: 0;
    font-size: 0.92rem;
  }

  a.channel-value:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .contact-grid,
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
