---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { history } from '../data/history';

const team = [
  { name: 'Amadeusz Gajewski', role: 'Founder & Lead Engineer' },
  { name: 'Yuri Meijer', role: 'Structures Engineer' },
];

// Open positions shown as "Looking for…" cards after the team.
const openRoles = ['Propulsion Engineer', 'Avionics & Software Engineer'];

const values = [
  {
    title: 'Research & development',
    body: 'Our R&D team develops new technology in-house — from vehicles and propulsion to materials and electronics — and shares its progress openly.',
  },
  {
    title: 'Engineering services',
    body: 'The same people, tools and know-how are available to clients as consultancy, custom development and products.',
  },
  {
    title: 'How we work',
    body: 'Short iteration cycles, honest reviews after every test and a bias toward building real hardware over endless paperwork.',
  },
];
---

<Layout title="About" description="The story and the people behind Aerospace Development Group.">
  <PageIntro eyebrow="About us" title="An engineering bureau built around its own R&D.">
    Aerospace Development Group was founded in 2021 to develop its own rocketry systems.
    Since then it has grown into an engineering bureau, registered in the Netherlands, that
    develops its own aerospace technology and helps other companies with engineering
    consultancy and product development.
  </PageIntro>

  <section class="values">
    <div class="wrap grid values-grid">
      {values.map((value) => (
        <div class="card">
          <h2>{value.title}</h2>
          <p>{value.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="history">
    <div class="wrap">
      <p class="eyebrow">Our history</p>
      <h2>From a rocketry project to an engineering bureau.</h2>
      <ol class="history-list">
        {history.map((item) => (
          <li>
            <p class="year">{item.year}</p>
            <div class="history-body">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ecosystem">
    <div class="wrap">
      <div class="card ecosystem-card">
        <div>
          <p class="eyebrow">Ecosystem</p>
          <h2>Part of the Dutch aerospace &amp; technology community.</h2>
        </div>
        <p>
          We work with universities, aerospace organisations and student teams across the
          Netherlands. These partnerships keep our research grounded and help bring new
          technology to the wider ecosystem. Interested in working together?
          <a href="/contact?topic=R%26D%20partnership">Get in touch</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="wrap">
      <p class="eyebrow">The team</p>
      <h2>Who's building this.</h2>
      <div class="grid team-grid">
        {team.map((member) => (
          <div class="card team-card">
            <div class="avatar" aria-hidden="true">{member.name.charAt(0)}</div>
            <div>
              <p class="team-name">{member.name}</p>
              <p class="team-role">{member.role}</p>
            </div>
          </div>
        ))}
        {openRoles.map((role) => (
          <a class="card team-card open-role" href="/contact?topic=Careers">
            <div class="avatar avatar-open" aria-hidden="true">+</div>
            <div>
              <p class="team-name">Looking for: {role}</p>
              <p class="team-role">Interested in joining? Get in touch →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .values-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .values-grid h2 {
    font-size: 1.2rem;
    margin: 0 0 10px;
  }

  .values-grid p {
    margin: 0;
    color: var(--text-muted);
  }

  .history h2,
  .team h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 8px 0 32px;
  }

  .history-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 860px;
  }

  .history-list li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
  }

  .year {
    margin: 0;
    padding-top: 2px;
    font-weight: 700;
    color: var(--accent);
    text-align: right;
  }

  .history-body {
    position: relative;
    padding: 0 0 32px 28px;
    border-left: 2px solid var(--border);
  }

  .history-list li:last-child .history-body {
    padding-bottom: 0;
  }

  .history-body::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
    box-sizing: border-box;
  }

  .history-list li:last-child .history-body::before {
    background: var(--accent);
  }

  .history-body h3 {
    margin: 0 0 6px;
    font-size: 1.1rem;
  }

  .history-body p {
    margin: 0;
    color: var(--text-muted);
  }

  .ecosystem-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px 48px;
    align-items: center;
    padding: 40px;
  }

  .ecosystem-card h2 {
    margin: 8px 0 0;
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
  }

  .ecosystem-card p:not(.eyebrow) {
    margin: 0;
    color: var(--text-muted);
  }

  .ecosystem-card a {
    color: var(--accent);
    font-weight: 600;
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--on-accent);
  }

  .open-role {
    border-style: dashed;
    background: transparent;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .open-role:hover {
    border-color: var(--accent);
  }

  .avatar-open {
    background: none;
    border: 2px dashed var(--border);
    color: var(--accent);
    font-size: 1.4rem;
    font-weight: 500;
  }

  .open-role .team-role {
    color: var(--accent);
  }

  .team-name {
    margin: 0;
    font-weight: 600;
  }

  .team-role {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .values-grid,
    .team-grid,
    .ecosystem-card {
      grid-template-columns: 1fr;
    }

    .ecosystem-card {
      padding: 28px;
    }

    .history-list li {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .year {
      text-align: left;
      padding: 0 0 6px 28px;
      border-left: 2px solid var(--border);
    }
  }
</style>
