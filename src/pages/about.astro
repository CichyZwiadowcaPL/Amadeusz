---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';

const team = [
  { name: 'Amadeusz Gajewski', role: 'Founder & Lead Engineer' },
  { name: 'Team member', role: 'Propulsion' },
  { name: 'Team member', role: 'Avionics & Software' },
  { name: 'Team member', role: 'Structures' },
];

const values = [
  {
    title: 'Research & development',
    body: 'Our R&D team develops new technology in-house — from vehicles and propulsion to materials and electronics — and shares its progress openly.',
  },
  {
    title: 'Engineering services',
    body: 'The same people, tools and know-how are available to clients as consultancy, custom development and products.',
  },
  {
    title: 'How we work',
    body: 'Short iteration cycles, honest reviews after every test and a bias toward building real hardware over endless paperwork.',
  },
];
---

<Layout title="About" description="The story and the people behind Aerospace Development Group.">
  <PageIntro eyebrow="About us" title="An engineering bureau built around its own R&D.">
    Aerospace Development Group started as a team building rockets and avionics from the
    ground up. Today we are an engineering bureau: we keep developing our own technology,
    and we help other companies and institutions solve their engineering problems.
  </PageIntro>

  <section class="values">
    <div class="wrap grid values-grid">
      {values.map((value) => (
        <div class="card">
          <h2>{value.title}</h2>
          <p>{value.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="team">
    <div class="wrap">
      <p class="eyebrow">The team</p>
      <h2>Who's building this.</h2>
      <div class="grid team-grid">
        {team.map((member) => (
          <div class="card team-card">
            <div class="avatar" aria-hidden="true">{member.name.charAt(0)}</div>
            <div>
              <p class="team-name">{member.name}</p>
              <p class="team-role">{member.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .values-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .values-grid h2 {
    font-size: 1.2rem;
    margin: 0 0 10px;
  }

  .values-grid p {
    margin: 0;
    color: var(--text-muted);
  }

  .team h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 8px 0 32px;
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--on-accent);
  }

  .team-name {
    margin: 0;
    font-weight: 600;
  }

  .team-role {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .values-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
